# Doação por Pix (tela /apoie). Copie este arquivo para .env.local e preencha.
# Em produção, configure as mesmas variáveis no painel da hospedagem e publique de novo.
# Sem os três primeiros, a tela mostra "Doações em breve".
VITE_PIX_KEY=
VITE_PIX_NAME=
VITE_PIX_CITY=
# Opcional: texto de "Para que serve".
# VITE_DONATION_PURPOSE=

# Fundo do mapa (opcional). O padrão é o do OpenStreetMap, que tem regras de uso.
# VITE_MAP_TILES_URL=
# VITE_MAP_ATTRIBUTION=
